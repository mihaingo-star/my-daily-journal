{
  // ① Replace with the exact name of your Worker (top of its page on Cloudflare)
  "name": "nom-de-ton-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "kv_namespaces": [
    // ② Replace with the ID of your KV namespace mdj-data (Storage & Databases → Workers KV)
    { "binding": "MDJ", "id": "COLLE-ICI-L-ID-DU-KV" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
